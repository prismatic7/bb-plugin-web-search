    "server": "./server.ts"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "bb plugin build .",
    "test": "node --test test/search.test.ts"
  }
}
